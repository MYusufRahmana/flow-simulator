{
  "version": 1,
  "project": {
    "id": "example-checkout",
    "name": "Contoh: Checkout Toko Online",
    "description": "Contoh lengkap: page, input, API, backend, database, layanan eksternal, decision \"Ask me\", jalur gagal, dan cabang paralel. Klik node untuk membaca penjelasannya.",
    "version": 1,
    "createdAt": "2026-10-13T09:52:25.406Z",
    "updatedAt": "2026-10-13T09:52:25.406Z",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "position": {
          "x": 36,
          "y": 0
        },
        "data": {
          "duration": 300,
          "label": "Pelanggan",
          "description": "Titik awal. Initial payload = data awal yang dibawa token.",
          "payload": "{\n  \"customer_id\": 88,\n  \"customer\": \"Budi Santoso\"\n}"
        }
      },
      {
        "id": "cart",
        "type": "page",
        "position": {
          "x": 0,
          "y": 120
        },
        "data": {
          "duration": 600,
          "label": "Halaman Keranjang",
          "config": {
            "route": "/cart"
          },
          "description": "Page / UI: layar yang dilihat user."
        }
      },
      {
        "id": "checkout",
        "type": "input",
        "position": {
          "x": 0,
          "y": 240
        },
        "data": {
          "duration": 700,
          "label": "Klik Checkout",
          "config": {
            "fields": "cart_id, alamat, kurir"
          },
          "description": "User Input: data yang dikirim user. Payload-nya digabung ke data token.",
          "payload": "{\n  \"cart_id\": \"CRT-1029\",\n  \"items\": 2,\n  \"total\": 250000,\n  \"kurir\": \"JNE REG\"\n}"
        }
      },
      {
        "id": "api",
        "type": "api",
        "position": {
          "x": 0,
          "y": 360
        },
        "data": {
          "duration": 900,
          "label": "Buat Order",
          "config": {
            "method": "POST",
            "endpoint": "/api/orders",
            "statusCode": 201,
            "response": "{\n  \"order_id\": \"ORD-5531\",\n  \"status\": \"PENDING\"\n}"
          },
          "description": "Coba ubah Status code ke 500: token akan mengikuti handle merah (FAILED)."
        }
      },
      {
        "id": "ctrl",
        "type": "backend",
        "position": {
          "x": 0,
          "y": 480
        },
        "data": {
          "duration": 600,
          "label": "OrderController",
          "config": {
            "handler": "store()"
          }
        }
      },
      {
        "id": "stock",
        "type": "process",
        "position": {
          "x": 0,
          "y": 600
        },
        "data": {
          "duration": 600,
          "label": "Validasi Stok",
          "description": "Aktifkan \"Simulate failure\" untuk melihat jalur Stok Habis."
        }
      },
      {
        "id": "save",
        "type": "database",
        "position": {
          "x": 0,
          "y": 720
        },
        "data": {
          "duration": 600,
          "label": "Simpan Order",
          "config": {
            "database": "shop",
            "table": "orders",
            "action": "TRANSACTION"
          }
        }
      },
      {
        "id": "pay",
        "type": "external",
        "position": {
          "x": 0,
          "y": 840
        },
        "data": {
          "duration": 1200,
          "label": "Payment Gateway",
          "config": {
            "service": "Midtrans"
          },
          "description": "External Service: layanan pihak ketiga. Bisa disimulasikan gagal."
        }
      },
      {
        "id": "paid",
        "type": "decision",
        "position": {
          "x": 0,
          "y": 960
        },
        "data": {
          "duration": 600,
          "label": "Pembayaran lunas?",
          "config": {
            "condition": "payment.status == 'settlement'",
            "outcome": "ASK"
          },
          "description": "Outcome \"Ask me\": simulasi berhenti dan kamu memilih TRUE atau FALSE."
        }
      },
      {
        "id": "markpaid",
        "type": "database",
        "position": {
          "x": 0,
          "y": 1080
        },
        "data": {
          "duration": 600,
          "label": "Tandai PAID",
          "config": {
            "database": "shop",
            "table": "orders",
            "action": "UPDATE"
          },
          "payload": "{\n  \"status\": \"PAID\"\n}",
          "description": "Punya 2 koneksi keluar: keduanya berjalan paralel."
        }
      },
      {
        "id": "ship",
        "type": "database",
        "position": {
          "x": 0,
          "y": 1200
        },
        "data": {
          "duration": 600,
          "label": "Buat Pengiriman",
          "config": {
            "database": "shop",
            "table": "shipments",
            "action": "INSERT"
          }
        }
      },
      {
        "id": "email",
